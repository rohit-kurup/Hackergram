    "leaflet": "1.9.4",
    "lucide-react": "0.511.0",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "5.0.0",
    "server-only": "^0.0.1",
    "zod": "3.25.42"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.18",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.4",
    "prisma": "6.8.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
