# ─── Database ───────────────────────────────────────────────
# Local dev uses SQLite (zero setup). See README for switching to PostgreSQL/Supabase.
DATABASE_URL="file:./dev.db"

# ─── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# 32+ random chars. Used to encrypt GitHub tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string"

# ─── GitHub OAuth (https://github.com/settings/developers → New OAuth App) ──
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Map tiles (optional) ───────────────────────────────────
# Defaults to OpenStreetMap's standard tiles. For Mapbox, e.g.:
# NEXT_PUBLIC_MAP_TILE_URL="https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_TOKEN"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="© Mapbox © OpenStreetMap"
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""

# ─── Gemma 4 AI ─────────────────────────────────────────────
# Default provider: Gemini API (Google AI Studio key: https://aistudio.google.com/apikey)
# Gemma 4 model IDs served by the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
AI_PROVIDER="gemini"            # "gemini" | "openai-compatible" (e.g. Ollama, vLLM)
GEMINI_API_KEY=""
GEMMA_MODEL="gemma-4-26b-a4b-it"
# Only for AI_PROVIDER=openai-compatible, e.g. Ollama: http://localhost:11434/v1 and model "gemma4"
AI_BASE_URL=""
AI_API_KEY=""
